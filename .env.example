# LLM calls are routed through Vercel AI Gateway (https://ai-gateway.vercel.sh) — one
# key covers both providers below, no separate vendor keys needed.
AI_GATEWAY_API_KEY=

# Claude model config — chat uses Sonnet for quality, fast tasks use Haiku
LLM_CLAUDE_CHAT=claude-sonnet-4-6
LLM_CLAUDE_FAST=claude-haiku-4-5-20251001

# OpenAI model config — chat uses GPT-4o, fast tasks use GPT-4o-mini
LLM_OPENAI_CHAT=gpt-4o
LLM_OPENAI_FAST=gpt-4o-mini

# LLM_PROVIDER sets the active provider at startup (claude or openai)
LLM_PROVIDER=claude

# Set to false to use live adapters
USE_FIXTURES=true

# Algolia (only needed when USE_FIXTURES=false)
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=

# Contentstack (only needed when USE_FIXTURES=false)
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=

# What to do when a category search returns zero results after all retries:
# 'fallback' relaxes the style filter and searches again; 'notice' shows an empty state
ZERO_RESULTS_ACTION=fallback

# Max wait (ms) for a single /api/chat LLM turn before it's treated as failed and the
# shopper gets a graceful error instead of a stalled spinner. Default 15000 if unset.
CHAT_TIMEOUT_MS=15000

# The port the app listens on.
PORT=3003

# Operator-only routes: the /debug/* dumps (which expose every session's captured intent and
# raw model output) and the POST routes that rewrite global model config for all users.
# Unset defaults to ON outside production and OFF when NODE_ENV=production, so the container
# is locked down by default and local development is unchanged. Never enable in public.
# ENABLE_ADMIN_ROUTES=true

# Rate limit for the endpoints that spend money (/api/chat, /api/show-me-now), per client
# address per window. In-memory, so per-process — a multi-instance deployment needs a shared
# store for the limit to hold globally.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
